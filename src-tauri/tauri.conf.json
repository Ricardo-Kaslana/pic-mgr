{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "PicMgr",
  "version": "0.3.16",
  "identifier": "com.pic-mgr.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PicMgr",
        "width": 1080,
        "height": 720,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Dawn.Wang",
    "copyright": "Copyright © 2026 Dawn.Wang",
    "category": "Photography",
    "shortDescription": "A lightweight, local-first image manager.",
    "longDescription": "PicMgr indexes local folders as workspaces and adds tags, ratings, notes and full-text search without ever modifying the original image files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
